{
  "name": "dsh-message-console",
  "version": "1.0.0",
  "description": "看点什么 — a personal source and message console for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "main": "src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./core": "./src/core.js",
    "./client": "./dist/client.js"
  },
  "files": [
    "src",
    "dist",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts/import-chrome-cookies.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.js",
    "check": "npm test && npm run build",
    "setup:runtime": "node scripts/ci/runtime.js",
    "test:ci": "node scripts/ci/test.js",
    "test:package": "node scripts/ci/package.js",
    "demo": "node scripts/demo.js",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "dsh-prompt-assembler": "~1.1.3",
    "dsh-jev-plugin": "~0.3.6"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "dsh-jev-plugin": "https://codeload.github.com/Player-MINEPIG/dsh-jev-plugin/tar.gz/2ec0510ffcdabe790df8c93b0b40aee07b93c342",
    "dsh-magpie-connect": "https://codeload.github.com/Player-MINEPIG/dsh-magpie-connect/tar.gz/80d107a7073a20a1bbbde3129e428c39ea94f2dd",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "dsh-prompt-assembler": "https://github.com/Player-MINEPIG/dsh-prompt-assembler/releases/download/v1.1.3/dsh-prompt-assembler-1.1.3.tgz"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependenciesMeta": {
    "dsh-prompt-assembler": {
      "optional": true
    },
    "dsh-jev-plugin": {
      "optional": true
    }
  }
}
